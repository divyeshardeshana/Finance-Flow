# ─── Frontend Environment Variables (Vite) ───────────────────────────────────
# Copy this file to .env and fill in your values.
# Variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secret keys in VITE_ variables.

# Supabase project URL (found in Supabase Dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous/public API key (safe to expose in the browser)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe publishable key (safe to expose in the browser — starts with pk_test_ or pk_live_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ─── Supabase Edge Function Secrets ──────────────────────────────────────────
# These are set via the Supabase CLI or Dashboard → Edge Functions → Secrets.
# They are NEVER placed in this file or exposed to the frontend.
#
# STRIPE_SECRET_KEY=sk_test_...          Stripe secret key (starts with sk_test_ or sk_live_)
# STRIPE_WEBHOOK_SECRET=whsec_...        Stripe webhook signing secret for signature verification
# SUPABASE_SERVICE_ROLE_KEY=...          Supabase service role key (bypasses RLS — keep secret)
# SUPABASE_URL=https://...               Supabase project URL (same as VITE_SUPABASE_URL)
